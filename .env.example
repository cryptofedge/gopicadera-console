# Copy to .env.local for local work. Never commit the filled-in version.
# On Vercel these go in Project Settings -> Environment Variables instead,
# so the real values never touch a repo at all.

# Supabase project URL. Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable / anon key. Safe in the browser: every query it makes is still
# filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses Row Level Security completely.
# Server-side only -- it is read exclusively by adminClient() in
# src/lib/supabase.ts, which is marked "server-only" so a stray import into a
# client component fails the build rather than shipping the key to a browser.
# Do not paste this into chat, a repo, or anywhere it can be logged.
SUPABASE_SERVICE_ROLE_KEY=
